{
  "name": "auktio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "ingest": "npx tsx --env-file=.env.local src/lib/ingest-pipeline.ts full",
    "ingest:feed": "npx tsx --env-file=.env.local src/lib/ingest-pipeline.ts feed",
    "ingest:sold-prices": "npx tsx --env-file=.env.local -e \"import { refreshAllSoldPrices } from './src/lib/feed-ingester.ts'; refreshAllSoldPrices().then((results) => { console.log(JSON.stringify(results, null, 2)); process.exit(0); }).catch((error) => { console.error(error); process.exit(1); });\"",
    "embed": "npx tsx --env-file=.env.local src/lib/embedding-ingester.ts",
    "describe": "npx tsx --env-file=.env.local src/lib/vision-describer.ts",
    "subjects": "npx tsx --env-file=.env.local src/lib/subject-enricher.ts",
    "categories:report": "npx tsx --env-file=.env.local exports/report-ai-category-candidates.ts",
    "categories:export": "npx tsx --env-file=.env.local exports/export-ai-category-candidates.ts",
    "subjects:import": "npx tsx --env-file=.env.local exports/import-ai-categories.ts",
    "db:setup": "npx tsx supabase/setup.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.39.0",
    "date-fns": "^3.3.0",
    "lucide-react": "^0.312.0",
    "next": "14.2.0",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
